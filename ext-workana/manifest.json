{
  "manifest_version": 3,
  "name": "Workana Assistant – Workana submitter",
  "version": "1.3.2",
  "description": "Fills (and optionally submits) Workana proposals sent from the local Workana Assistant hub.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://www.workana.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.workana.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Workana Assistant – Workana" }
}
