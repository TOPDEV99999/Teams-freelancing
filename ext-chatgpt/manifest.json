{
  "manifest_version": 3,
  "name": "Workana Assistant – ChatGPT bridge",
  "version": "1.2.0",
  "description": "Receives prompts from the local Workana Assistant hub and returns ChatGPT's reply.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Workana Assistant – ChatGPT" }
}
