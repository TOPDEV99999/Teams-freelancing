# ---- Workana Assistant hub configuration ----
# Port the hub listens on (always bound to 127.0.0.1).
HUB_PORT=8766

# Shared secret the extensions must send on register. Paste the same value into
# each extension's popup. `py -m hub` generates one automatically on first run.
HUB_SHARED_SECRET=change-me

# Which job fetcher to run: workana | mine | demo | none
#   workana = built-in Workana fetcher (filters on the dashboard's Fetcher page)
#   mine    = my_fetcher.py (your own code; falls back to workana while it's the empty template)
#   demo    = generates fake jobs for testing
FETCHER=workana
FETCH_INTERVAL_SECONDS=60

# Proposal generation: chatgpt_web | openai_api
GENERATION_PROVIDER=chatgpt_web
GENERATION_TIMEOUT_SECONDS=300
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# How long the hub waits for a Workana extension to report a result
# (fill_only mode waits for you to click Workana's submit button).
SUBMIT_TIMEOUT_SECONDS=900

# Optional: override DB location
# DATABASE_URL=sqlite:///data/hub.db
